{
  "name": "gym-scoreboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:web": "cmd /c attrib +P -U frontend /S /D",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run clean:web && npm run prepare:web && next dev ./frontend",
    "dev:api": "tsx watch backend/src/index.ts",
    "build": "npm run build:web && npm run build:api",
    "clean:web": "node -e \"require('node:fs').rmSync('frontend/.next', { recursive: true, force: true })\"",
    "build:web": "npm run clean:web && npm run prepare:web && next build ./frontend",
    "build:api": "tsc -p backend/tsconfig.json",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "start:web": "next start ./frontend",
    "start:api": "node backend/dist/index.js",
    "db:migrate": "tsx backend/src/scripts/migrate.ts",
    "db:seed": "tsx backend/src/scripts/seed.ts",
    "lint": "tsc -p frontend/tsconfig.json --noEmit --incremental false && tsc -p backend/tsconfig.json --noEmit --incremental false"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "next": "^15.3.0",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
