PORT=4000
# Local (docker-compose)
DATABASE_URL=postgres://postgres:postgres@localhost:55432/gym_scoreboard
# Produccion Neon - ejemplo (con sslmode requerido para Vercel/Neon):
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/gym_scoreboard?sslmode=require
CLIENT_URL=http://localhost:3000
# Para produccion con multiple origen (local + vercel), usar coma: http://localhost:3000,https://tu-app.vercel.app
# CLIENT_URL=https://tu-app.vercel.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# En Vercel (frontend) setear NEXT_PUBLIC_API_BASE_URL a la URL del backend desplegado (ej: https://api.onrender.com o https://neon-backend.fly.dev)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
